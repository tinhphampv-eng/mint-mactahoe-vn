-- @@X@@ @@Y@@ @@H@@ duoc thay boi widgets.sh
conky.config = {
    alignment = 'top_right',
    gap_x = @@X@@,
    gap_y = @@Y@@,
    minimum_width = 300, maximum_width = 300,
    minimum_height = @@H@@,
    background = true,
    double_buffer = true,
    update_interval = @@INTERVAL@@,
    own_window = true,
    own_window_type = 'desktop',
    own_window_class = 'Conky',
    own_window_argb_visual = true,
    own_window_argb_value = 0,
    own_window_transparent = true,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',
    border_inner_margin = 18,
    draw_shades = false, draw_borders = false, draw_graph_borders = false,
    use_xft = true,
    font = 'Inter:size=10',
    default_color = 'f5f5f7',
    color1 = '0a84ff',   -- xanh macOS
    color2 = '98989d',   -- xam phu
    color3 = 'ff9f0a',   -- cam
    override_utf8_locale = true,
    cpu_avg_samples = 2,
    lua_load = '@@DIR@@/card.lua',
    lua_draw_hook_pre = 'card',
}
